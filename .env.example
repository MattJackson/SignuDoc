# A site made with the "Deploy with Vercel" button needs nothing from this
# file: Vercel connects the database, the file store and email by itself.
# The three settings below are what local development needs. Everything
# after them is optional.

# Postgres. `npm run db:start` runs one locally with these credentials.
DATABASE_URL=postgres://signudoc:signudoc@127.0.0.1:5432/signudoc

# Public URL of the app, used for links, auth callbacks, and emails.
# On Vercel, leave this unset: the project's own domain is used.
APP_URL=http://localhost:3000

# "capture" writes each email to .data/outbox as JSON instead of sending it,
# which is all local development needs. Remove this line, or set "resend",
# to send through Resend with the key below.
EMAIL_DRIVER=capture

# ---------------------------------------------------------------------------
# Optional
# ---------------------------------------------------------------------------

# Resend API key, for sending real email. On Vercel the Resend integration
# sets it.
# RESEND_API_KEY=

# The support address, where replies go, is asked for when the site is set
# up. It and the address email is sent from can be changed in the app, under
# Settings, Organization. Set these only to fix them from the environment
# instead; they then cannot be changed in the app, and the setup page does
# not ask for a support address.
# RESEND_FROM_EMAIL=
# SUPPORT_EMAIL=

# BETTER_AUTH_URL defaults to APP_URL. BETTER_AUTH_SECRET defaults to a
# value derived from the database password; set your own (for example with
# `openssl rand -hex 32`) if you want sign-ins to survive a database
# password change. In production a derived secret needs a database password
# of at least 12 characters.
# BETTER_AUTH_URL=http://localhost:3000
# BETTER_AUTH_SECRET=

# The first person to open a new install sets it up at /setup and becomes
# its administrator. Set a secret here and the setup page asks for it, so
# that finding the URL first is not enough. It is also what lets a
# signed-in user take charge of an install that has accounts but no
# administrator.
# SETUP_TOKEN=

# The daily cleanup at /api/internal/retention is safe to leave open: it
# runs at most once an hour and tells the caller nothing. Set a secret to
# close it to everyone who does not send it as a bearer token. On Vercel use
# CRON_SECRET, which Vercel sends on its own cron calls.
# RETENTION_JOB_SECRET does the same for a scheduler of your own elsewhere.
# CRON_SECRET=
# RETENTION_JOB_SECRET=

# Vercel only. BOTID=1 turns on Vercel BotID for sign-in, sign-up, password
# reset, the contact form and first-run setup. It is read when the app is
# built, so redeploy after changing it. See "Bot protection" in docs/self-hosting.md
# before turning it on.
# BOTID=

# HOSTED_MODE=1 runs SignuDoc as a public service under its own name:
# landing page, built-in terms and privacy pages, sign-up open to anyone.
# Leave it unset for an install that belongs to one organization.
# HOSTED_MODE=

# File storage. Unset, PDFs are kept on this machine under .data/storage
# (STORAGE_LOCAL_DIR changes where). On Vercel, connect a Blob store to the
# project and leave this unset: the store is picked up by itself.
# STORAGE_DRIVER=blob or =local forces one. STORAGE_DRIVER=gcs keeps them in
# a Google Cloud Storage bucket instead (GCS_BUCKET, and optionally a folder
# in it, GCS_PREFIX); see "Files in Google Cloud Storage" in
# docs/self-hosting.md.
# STORAGE_DRIVER=local
# STORAGE_LOCAL_DIR=
# GCS_BUCKET=
# GCS_PREFIX=

# Resend region for the sending domain the app adds for you: us-east-1
# (default), eu-west-1, sa-east-1 or ap-northeast-1. Use eu-west-1 to send
# from the EU. See "Running in the EU" in docs/self-hosting.md.
# RESEND_REGION=

# The seal on finished PDFs. Usually chosen in the app instead: Settings,
# Seal & timestamp (also an onboarding step), where an administrator can
# upload a .p12 or .pfx file. Unset here and there, the install makes its
# own key and self-signed certificate on first use (kept encrypted in the
# database with a key derived from BETTER_AUTH_SECRET, so keep that secret
# stable). Set here, a base64 PKCS#12 (.p12) file and its password win over
# Settings, which then shows the certificate as fixed.
# SEAL_P12_BASE64=
# SEAL_P12_PASSWORD=

# An RFC 3161 timestamp server, to add a trusted time to each seal. Usually
# chosen in Settings, Seal & timestamp: a new install starts with DigiCert's
# free http://timestamp.digicert.com, and an install set up before that
# setting keeps sealing without one until an administrator chooses. Set
# here, it wins over Settings; "off" turns timestamps off. With a server,
# seals also get long-term validation (PAdES B-LTA): the certificates,
# revocation answers and an archive timestamp go into the PDF. If the
# server cannot be reached, the PDF is sealed without a timestamp.
# SEAL_TIMESTAMP_URL=

# Signatures in the signers' own names (eIDAS advanced or qualified), through
# a signing provider outside Vercel. Unset, signers make simple electronic
# signatures. See "Signatures in the signers' own names" in
# docs/self-hosting.md.
#
# eID Easy (eideasy.com). EIDEASY_API_URL=https://test.eideasy.com for its
# test environment.
# EIDEASY_CLIENT_ID=
# EIDEASY_SECRET=
# EIDEASY_API_URL=
#
# A trust service provider's CSC API v2 remote signing service.
# CSC_API_URL=
# CSC_CLIENT_ID=
# CSC_CLIENT_SECRET=
# CSC_PROVIDER_NAME=
# CSC_OAUTH_URL=
#
# With both set: eideasy (the default) or csc.
# SIGNING_PROVIDER=

# Single sign-on with your organization's identity provider over OpenID
# Connect (Okta, Microsoft Entra ID, Google Workspace, and others). Unset,
# people sign in with a password. Register this redirect URI with the
# provider: <your site>/api/auth/callback/sso. See "Single sign-on" in
# docs/self-hosting.md.
# SSO_ISSUER=https://acme.okta.com
# SSO_CLIENT_ID=
# SSO_CLIENT_SECRET=
# What the button says after "Continue with".
# SSO_NAME=Okta
#
# off: only single sign-on, once it is set up. The listed addresses keep a
# password, for when the identity provider is down.
# PASSWORD_SIGN_IN=off
# PASSWORD_SIGN_IN_ALLOWED_EMAILS=admin@acme.com
#
# All of the above can be set in the app instead (Settings, Google
# Workspace); a variable that is set here wins.

# Google Workspace (docs/google-workspace.md). Each can be set in the app.
# The Workspace domains Google sign-in is held to (the hd claim). Unset, the
# sign-up rule's domains.
# GOOGLE_WORKSPACE_DOMAINS=acme.com
# on: suggest recipients from the Workspace directory, read as the app's
# service account (a read-only admin role, or domain-wide delegation).
# GOOGLE_WORKSPACE_DIRECTORY=on
# Only with domain-wide delegation: the administrator to read it as.
# GOOGLE_WORKSPACE_ADMIN_SUBJECT=admin@acme.com
# GOOGLE_WORKSPACE_CUSTOMER_ID=my_customer
# Members of this group are administrators, synced at each Google sign-in.
# GOOGLE_ADMIN_GROUP=signudoc-admins@acme.com
# on: offboarding from the directory. A scheduled call to
# /api/internal/directory-sync (with RETENTION_JOB_SECRET as a bearer token)
# blocks the sign-in of people the directory says are suspended, archived or
# gone, and hands their open envelopes and drafts to their manager or an
# administrator. off keeps it off whatever the app says.
# DIRECTORY_SYNC=on
# The most people one run offboards, 1 to 500. The rest wait for the next run.
# DIRECTORY_SYNC_MAX_PER_RUN=10
# The sender's manager, from the directory, approving first: off, suggest
# (the signers and review pages suggest it) or require (an envelope is not
# sent without the manager as an approver in the first step). Can also be
# set in the app, where it can be limited to chosen teams.
# MANAGER_APPROVAL=suggest
# Employees sign with Google: off, offer or require. Signers whose address is
# in GOOGLE_WORKSPACE_DOMAINS confirm who they are by being signed in here
# with Google, on top of any check the sender asked for. Needs Google
# sign-in. Can also be set in the app.
# GOOGLE_SIGNING=offer
#
# The Gmail and Drive add-on (docs/google-workspace.md, part 8). Both come
# from `gcloud workspace-add-ons get-authorization` after the deployment is
# made; until both are set, the add-on's URLs answer 404.
# GOOGLE_ADDON_SERVICE_ACCOUNT=service-123456789@gcp-sa-gsuiteaddons.iam.gserviceaccount.com
# GOOGLE_ADDON_CLIENT_ID=
# Only when Google calls the site through another address, such as a proxy:
# more URLs accepted as the audience of Google's ID token, comma-separated.
# GOOGLE_ADDON_AUDIENCE=

# Google Drive (docs/google-workspace.md#7-google-drive). Each can be set in
# the app. People connect their own Drive with the Google sign-in OAuth
# client above (drive.file only).
# "Choose from Google Drive" on the new-envelope page: a browser API key
# restricted to the Picker API and this site, and the Cloud project number.
# GOOGLE_PICKER_API_KEY=
# GOOGLE_DRIVE_APP_ID=123456789012
# A copy of every executed envelope (sealed PDF and certificate) in this
# Shared Drive, by the app's service account (a Content manager there).
# GOOGLE_DRIVE_EXPORT_DRIVE_ID=
# Folders, then the file name. Default: {yyyy}/{yyyy-MM-dd} — {title} — {shortId}
# GOOGLE_DRIVE_EXPORT_FOLDER_PATTERN=
# A Drive label on each executed copy, and which envelope value fills each
# field, as JSON: {"fieldId":"title"}. Values: title, senderName,
# senderEmail, senderTeam, completedDate, counterparty, counterpartyEmail,
# envelopeId.
# GOOGLE_DRIVE_LABEL_ID=
# GOOGLE_DRIVE_LABEL_FIELDS=
# Only with domain-wide delegation: the user labels are applied as.
# GOOGLE_DRIVE_LABELS_SUBJECT=

# Where the visitor's IP address is read from, away from Vercel. Unset, it
# is the last entry of X-Forwarded-For, which is right on Cloud Run and
# behind one reverse proxy. TRUSTED_PROXY_HOPS is how many proxies append
# to that header (2 behind a Google Cloud external Application Load
# Balancer). CLIENT_IP_HEADER reads one header instead, for a proxy that
# always overwrites it, such as cf-connecting-ip behind Cloudflare. See
# "The visitor's address" in docs/self-hosting.md.
# TRUSTED_PROXY_HOPS=1
# CLIENT_IP_HEADER=

# Audit rows are copied to the function logs as JSON lines, for a Vercel log
# drain to send on to a SIEM. off keeps them out of the logs.
# AUDIT_LOG=off

# A daily backup, usually set up in Settings, Backups. Set here, these win
# and Settings shows them as locked: a Google Cloud Storage bucket (and a
# folder in it), or a second, private Vercel Blob store by its read-write
# token, and how many days of copies to keep (30 by default). See
# docs/backup-and-restore.md.
# BACKUP_GCS_BUCKET=
# BACKUP_GCS_PREFIX=
# BACKUP_BLOB_READ_WRITE_TOKEN=
# BACKUP_KEEP_DAYS=30

# Notifications in Slack (docs/notifications.md), usually set up in Settings,
# Notifications. A variable set here wins. The bot token of a Slack app made
# from the manifest on that page (xoxb-...).
# SLACK_BOT_TOKEN=
# How many days before a deadline to warn once, and how many days without
# activity count as stuck (3 and 7 by default, 0 turns either off).
# NOTIFICATION_EXPIRING_DAYS=3
# NOTIFICATION_STUCK_DAYS=7

# Where "Check for updates" in Settings looks for new releases, as
# owner/repository. Unset, it is this fork (package.json, "repository").
# SIGNUDOC_RELEASES_REPO=MattJackson/SignuDoc
