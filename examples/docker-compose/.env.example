# Copy this file to .env. Generate each secret with: openssl rand -base64 32

# The address people open. Use the public HTTPS address if you have one
# (see README.md), otherwise http://localhost:8080.
APP_URL=http://localhost:8080

# Signs sessions. Keep it: a new value signs everyone out.
BETTER_AUTH_SECRET=

# Lets the scheduler service call the daily job routes.
RETENTION_JOB_SECRET=

# Optional. When set, the first-run setup page asks for it.
SETUP_TOKEN=

# "capture" writes email to /data/outbox instead of sending it. Set "resend"
# and RESEND_API_KEY to send real email.
EMAIL_DRIVER=capture
RESEND_API_KEY=

# Only for the optional Cloudflare Tunnel service in compose.yaml.
# TUNNEL_TOKEN=

# Only for Google Workspace without a service account key (README.md).
# GOOGLE_IMPERSONATE_SERVICE_ACCOUNT=name@project.iam.gserviceaccount.com
